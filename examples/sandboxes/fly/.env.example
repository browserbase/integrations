# Browserbase credentials — get them at https://www.browserbase.com/settings
#
# On Fly, set these as app secrets (encrypted, injected as env at runtime):
#   fly secrets set BROWSERBASE_API_KEY=bb_live_... BROWSERBASE_PROJECT_ID=...
#
# This .env is only for the local Docker-equivalent smoke test (see README → Testing).
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000
