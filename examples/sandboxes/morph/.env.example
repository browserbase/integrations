# Browserbase — the Verified browser the `browse` CLI connects out to.
# Get these from https://www.browserbase.com/settings
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Morph Cloud — the microVM that runs the `browse` CLI / your agent loop.
# Get this from https://cloud.morph.so
MORPH_API_KEY=morph_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the protected site the demo visits.
# TARGET_URL=https://nowsecure.nl
