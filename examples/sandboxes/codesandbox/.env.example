# Browserbase credentials — get them at https://www.browserbase.com/settings
# These are injected into the CodeSandbox microVM as env vars when the SDK
# driver (create.mjs) runs the demo command.
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# CodeSandbox SDK API key — get it at https://codesandbox.io/t/api
# Required by create.mjs (the @codesandbox/sdk driver) and by
# `npx @codesandbox/sdk build`. Not needed for the local Docker-equivalent test.
CSB_API_KEY=csb_xxxxxxxxxxxxxxxxxxxxxxxx
