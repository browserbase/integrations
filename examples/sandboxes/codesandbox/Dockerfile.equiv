# Dockerfile.equiv — local, Docker-equivalent of the CodeSandbox golden image
# defined by tpl/.devcontainer/Dockerfile + tpl/.codesandbox/tasks.json.
#
# A CodeSandbox SDK sandbox is a Firecracker microVM that boots the
# .devcontainer image, then runs the tasks in .codesandbox/tasks.json:
#
#   .devcontainer/Dockerfile:  FROM node:20-slim → npm install -g browse@latest
#   tasks.json setupTasks:     ensure browse → browse --version
#   tasks.json task command:   ./browsecli-demo.sh
#
# This Dockerfile replicates those exact load-bearing steps (node:20-slim +
# global `browse` + the demo script) so the in-VM behavior can be proven WITHOUT
# a CodeSandbox API key (CSB_API_KEY). The microVM has no Chrome either — the
# browser lives on Browserbase and is reached over CDP at run time.
FROM node:20-slim

RUN npm install -g browse@latest \
    && browse --version

WORKDIR /app
COPY tpl/browsecli-demo.sh /app/browsecli-demo.sh
RUN chmod +x /app/browsecli-demo.sh

ENV TARGET_URL=https://nowsecure.nl

CMD ["/app/browsecli-demo.sh"]
