# Dockerfile.equiv — local stand-in for the Vercel Sandbox runtime.
#
# The Vercel Sandbox is an Amazon-Linux Firecracker microVM with Node. This
# image replicates the IN-SANDBOX behavior of sandbox.ts (npm i -g browse +
# run the demo) so we can prove the BrowseCLI flow end-to-end WITHOUT a Vercel
# token. It mirrors examples/sandboxes/_shared/Dockerfile.
#
#   docker build -t browsecli-sandbox:vercel -f Dockerfile.equiv .
#   docker run --rm \
#     -e BROWSERBASE_API_KEY="$BROWSERBASE_API_KEY" \
#     -e BROWSERBASE_PROJECT_ID="$BROWSERBASE_PROJECT_ID" \
#     browsecli-sandbox:vercel /app/browsecli-demo.sh
FROM node:20-slim

RUN npm install -g browse@latest \
    && browse --version

WORKDIR /app
COPY browsecli-demo.sh /app/browsecli-demo.sh
RUN chmod +x /app/browsecli-demo.sh

ENV TARGET_URL=https://nowsecure.nl

CMD ["/app/browsecli-demo.sh"]
