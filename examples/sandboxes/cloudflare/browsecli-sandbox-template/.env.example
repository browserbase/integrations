# Browserbase credentials — get them at https://www.browserbase.com/settings
#
# On Cloudflare these are NOT read from .env. They are:
#   - encrypted Worker secrets in production:
#       wrangler secret put BROWSERBASE_API_KEY
#   - .dev.vars entries for local `wrangler dev` (see .dev.vars.example)
#
# This .env is only used by the Docker-equivalent smoke test (../Dockerfile.test),
# which proves the container actually runs the BrowseCLI and reaches real content.
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
