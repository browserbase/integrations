# Browserbase credentials — get them at https://www.browserbase.com/settings
#
# On Northflank these are template arguments (BROWSERBASE_API_KEY /
# BROWSERBASE_PROJECT_ID) that the template materializes into a SecretGroup and
# injects into the job's runtime environment. Put real secrets in the template's
# "argument overrides" (stored encrypted, not committed), not in the spec.
#
# This .env is only for the local Docker-equivalent smoke test (Dockerfile).
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000
