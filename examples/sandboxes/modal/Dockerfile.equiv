# Dockerfile.equiv — local, Docker-equivalent of the Modal image in
# browsecli_in_modal.py. Modal builds its image in code:
#
#   modal.Image.from_registry("node:20-slim", add_python="3.12")
#       .run_commands("npm install -g browse@latest", "browse --version")
#       .add_local_file("browsecli-demo.sh", "/app/browsecli-demo.sh", copy=True)
#
# This Dockerfile replicates those exact steps so the in-sandbox behavior can be
# proven without a Modal token. (add_python is irrelevant to the browse demo, so
# we mirror only the load-bearing layers: node:20-slim + browse + the script.)
FROM node:20-slim

RUN npm install -g browse@latest \
    && browse --version

WORKDIR /app
COPY browsecli-demo.sh /app/browsecli-demo.sh
RUN chmod +x /app/browsecli-demo.sh

ENV TARGET_URL=https://nowsecure.nl

CMD ["/app/browsecli-demo.sh"]
