# Browserbase credentials — get them at https://www.browserbase.com/settings
# The Modal Function reads these from a Modal Secret named "browserbase":
#   modal secret create browserbase BROWSERBASE_API_KEY=... BROWSERBASE_PROJECT_ID=...
#
# This .env is only for the local Docker-equivalent smoke test (Dockerfile.equiv).
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000
