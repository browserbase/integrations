# Credentials read from your LOCAL env at `modal run` time and injected into the
# Function via Secret.from_dict (no pre-created Modal Secret required to try it).
#
# Anthropic API key — runs the agent loop. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Browserbase API key — drives the remote browser. Get one at https://www.browserbase.com/settings
BROWSERBASE_API_KEY=bb_live_xxxxxxxxxxxxxxxxxxxxxxxx
