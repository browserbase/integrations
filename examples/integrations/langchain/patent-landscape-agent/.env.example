OPENAI_API_KEY=sk-...
BROWSERBASE_API_KEY=bb_...
# BROWSERBASE_PROJECT_ID=prj_...  # optional; scopes sessions to a specific project

# Optional: override the orchestrator model (default: gpt-4.1)
# PATENT_AGENT_MODEL=gpt-4.1

# Optional: override the Stagehand browser agent model (default: openai/gpt-4.1)
# STAGEHAND_MODEL=openai/gpt-4o

# Optional: LangSmith traces
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
