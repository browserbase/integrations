BROWSERBASE_API_KEY=

# Run `pnpm setup-context` once, then paste the returned ID here.
BROWSERBASE_CONTEXT_ID=

# Run `pnpm create-agent` once, then paste the returned ID here.
BROWSERBASE_AGENT_ID=

# Login page for the one-time context setup and the private PDF page the Agent
# should visit. A private Google Drive PDF works well for this demo.
AUTH_START_URL=https://drive.google.com/drive/my-drive
PROTECTED_PAGE_URL=
PROTECTED_PDF_LINK_TEXT=Download

# Create a Server app using Client Credentials Grant in the Box Developer Console.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Share this folder with the app's service account using the Editor role.
BOX_FOLDER_ID=
