BROWSERBASE_API_KEY=

# Create a short-lived Developer Token in the Box Developer Console.
BOX_DEVELOPER_TOKEN=

# The Box folder that receives the downloaded files. "0" is the authenticated user's root.
BOX_FOLDER_ID=0

# Optional source overrides. The defaults download a Clorox SDS PDF and an EPA
# disinfectant-label PNG.
SDS_PAGE_URL=https://www.thecloroxcompany.com/sds/clorox-disinfecting-wipes1-fresh-scent/
SDS_LINK_TEXT=Download Safety Data Sheet
LABEL_PAGE_URL=https://www.epa.gov/safepestcontrol/why-read-labels
LABEL_LINK_TEXT=How to Read a Disinfectant Label
