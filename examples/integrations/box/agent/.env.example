BROWSERBASE_API_KEY=

# Run `pnpm setup-context` once, then paste the returned ID here.
BROWSERBASE_CONTEXT_ID=

# Run `pnpm create-agent` once, then paste the returned ID here.
BROWSERBASE_AGENT_ID=

# The PG&E portal used for the one-time login and subsequent Agent runs.
PGE_PORTAL_URL=https://www.pge.com/myaccount

# Create a Server app using Client Credentials Grant in the Box Developer Console.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Share this folder with the app's service account using the Editor role.
BOX_FOLDER_ID=
